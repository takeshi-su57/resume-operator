# LLM Provider Configuration
#
# The pipeline uses LangChain's `with_structured_output` for all LLM calls,
# which relies on provider-native function/tool-calling. Pick a model that
# supports strict JSON schema / tool use:
#   - openai: gpt-4o, gpt-4o-mini, gpt-4-turbo (tool-calling supported)
#   - anthropic: claude-3-5-sonnet, claude-3-5-haiku (tool-calling supported)
#   - google: gemini-1.5-pro, gemini-1.5-flash (partial — may drop defaults)
#   - openrouter: prefer OpenAI-origin models (openai/gpt-4o-mini works;
#     open-weights models like openai/gpt-oss-120b may return truncated/invalid
#     responses under strict JSON mode)
LLM_PROVIDER=openai          # openai | anthropic | google | openrouter
LLM_MODEL=gpt-4o             # Model name (provider-specific)

# API Keys (set the one matching your LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Logging
LOG_LEVEL=INFO

# ATS Score Threshold — skip optimization when score is at or above this value
ATS_SKIP_THRESHOLD=0.9

# PDF render template (default | compact | modern). Only `default` is implemented today.
RESUME_TEMPLATE=default

# Path to a StyleTemplate YAML (issue #72). If set, every `run` uses it unless
# `--style PATH` is passed. Leave empty to use the built-in defaults.
RESUME_STYLE_PATH=

# #78 iterative approval loop — cap on consecutive rejected iterations before
# the "continue anyway?" prompt fires. Overridden by `run --max-iter N`.
RESUME_MAX_ITERATIONS=3

# #81 ATSReport composite weights — each dimension's contribution to the
# overall score. Defaults sum to 1.0; tune when a JD emphasizes one
# dimension more than the baseline.
ATS_WEIGHT_HARD=0.40         # hard skill coverage (JD tools / techs / frameworks)
ATS_WEIGHT_SOFT=0.20         # soft skill coverage (mentoring / collaboration / …)
ATS_WEIGHT_STRUCTURAL=0.15   # contact + sections + word-count presence
ATS_WEIGHT_TITLE=0.10        # JD job title match on the resume
ATS_WEIGHT_MEASURABLE=0.10   # quantified-impact bullet count vs. target (8)
ATS_WEIGHT_TONE=0.05         # inverse of cliche / vague-positive flag count
